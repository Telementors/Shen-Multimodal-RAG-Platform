# =============================================================================
# Shen Multimodal RAG — Backend Configuration (OpenAI Mode)
# =============================================================================
# This configuration uses OpenAI cloud models for higher quality outputs.
# Requires a valid OpenAI API key. Costs apply per token usage.
#
# Usage:
#   cp backend.env.openai ../src/Shen_RAG_Core/.env
#   # Then edit the file and replace 'sk-your-openai-api-key-here' with your
#   # actual OpenAI API key.
# =============================================================================

# --- PostgreSQL (pgvector) ---------------------------------------------------
# Connection string for PostgreSQL with pgvector extension.
# For Docker Compose: use 'postgres' as host (service name).
# For local dev:      use 'localhost'.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multimodal_rag

# --- OpenAI (Cloud) ---------------------------------------------------------
# ⚠️ IMPORTANT: Replace with your actual OpenAI API key!
OPENAI_API_KEY=sk-your-openai-api-key-here

# Leave OPENAI_BASE_URL empty or remove it to use the official OpenAI endpoint.
# OPENAI_BASE_URL=

# Embedding model: text-embedding-3-small produces 1536-dimensional vectors.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# LLM models: gpt-4o-mini for all reasoning tasks.
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=gpt-4o-mini
OPENAI_TABLE_DESCRIPTION_MODEL=gpt-4o-mini

# --- PDF Parser --------------------------------------------------------------
# Parsing strategy: 'fast' (recommended) or 'hi_res' (slower, better for scans).
UNSTRUCTURED_STRATEGY=fast

# Leave empty to use default image output directory (data/images).
IMAGE_OUTPUT_DIR=

# Set to 'true' to use LLM-generated table descriptions (recommended with OpenAI).
# OpenAI models produce high-quality table summaries.
USE_LLM_TABLE_DESCRIPTIONS=true

# --- RAG Retrieval -----------------------------------------------------------
# Number of top-k chunks retrieved per query modality.
RAG_TOP_K=5

# --- FastAPI -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Set to 'true' for development (auto-reload on file changes).
# Set to 'false' for production/Docker.
API_RELOAD=true

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory where uploaded PDFs are stored.
UPLOAD_DIR=data/uploads

# --- Langfuse (Optional Observability) --------------------------------------
# Leave empty to disable tracing. Fill in to enable Langfuse observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Corpus Auto-Indexing ----------------------------------------------------
# Path to the document corpus for automatic pre-indexing on startup.
CORPUS_DIR=Ashen_Era_Data/Ashen_Era_Archive
CORPUS_NAME=Ashen Era Archive

# Set to 'true' to re-index all documents on every startup.
# Set to 'false' to skip already-indexed documents (idempotent).
CORPUS_CLEAN_ON_START=false
