# =============================================================================
# Shen Multimodal RAG — Frontend Configuration (Next.js)
# =============================================================================
# Next.js exposes variables prefixed with NEXT_PUBLIC_ to the browser.
#
# Usage:
#   cp frontend.env.local ../src/Shen_App/.env.local
# =============================================================================

# --- Backend API URL ---------------------------------------------------------
# The URL where the FastAPI backend is accessible.
#
# For local development:    http://localhost:8000
# For Docker Compose:       http://localhost:8000 (mapped via ports)
# For production:           https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000
