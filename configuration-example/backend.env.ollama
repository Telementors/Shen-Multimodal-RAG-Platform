# =============================================================================
# Shen Multimodal RAG — Backend Configuration (Ollama Mode)
# =============================================================================
# This configuration runs the platform 100% locally using Ollama.
# No API key needed. No cloud costs. Just Docker + Ollama.
#
# Usage:
#   cp backend.env.ollama ../src/Shen_RAG_Core/.env
# =============================================================================

# --- PostgreSQL (pgvector) ---------------------------------------------------
# Connection string for PostgreSQL with pgvector extension.
# For Docker Compose: use 'postgres' as host (service name).
# For local dev:      use 'localhost'.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/multimodal_rag

# --- Ollama (Local AI — 100% Free, No API Key Needed) -----------------------
# Setting OPENAI_API_KEY to 'ollama' enables local mode.
# OPENAI_BASE_URL points to the Ollama OpenAI-compatible endpoint.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1

# Embedding model: nomic-embed-text produces 768-dimensional vectors.
OPENAI_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# LLM models: llama3.2 handles all reasoning tasks.
OPENAI_VISION_MODEL=llama3.2
OPENAI_ROUTER_MODEL=llama3.2
OPENAI_ANSWER_MODEL=llama3.2
OPENAI_TABLE_DESCRIPTION_MODEL=llama3.2

# --- PDF Parser --------------------------------------------------------------
# Parsing strategy: 'fast' (recommended) or 'hi_res' (slower, better for scans).
UNSTRUCTURED_STRATEGY=fast

# Leave empty to use default image output directory (data/images).
IMAGE_OUTPUT_DIR=

# Set to 'true' to use LLM-generated table descriptions (slower but richer).
# Set to 'false' for deterministic formatting (faster, works offline).
USE_LLM_TABLE_DESCRIPTIONS=false

# --- RAG Retrieval -----------------------------------------------------------
# Number of top-k chunks retrieved per query modality.
RAG_TOP_K=5

# --- FastAPI -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Set to 'true' for development (auto-reload on file changes).
# Set to 'false' for production/Docker.
API_RELOAD=true

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory where uploaded PDFs are stored.
UPLOAD_DIR=data/uploads

# --- Langfuse (Optional Observability) --------------------------------------
# Leave empty to disable tracing. Fill in to enable Langfuse observability.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Corpus Auto-Indexing ----------------------------------------------------
# Path to the document corpus for automatic pre-indexing on startup.
CORPUS_DIR=Ashen_Era_Data/Ashen_Era_Archive
CORPUS_NAME=Ashen Era Archive

# Set to 'true' to re-index all documents on every startup.
# Set to 'false' to skip already-indexed documents (idempotent).
CORPUS_CLEAN_ON_START=false
